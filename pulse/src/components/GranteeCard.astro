---
import type { Grantee } from '../lib/types';

interface Props {
  grantee: Grantee;
}

const { grantee } = Astro.props;
---

<article class="rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
  <h3 class="font-semibold text-ri-navy">{grantee.name}</h3>
  <dl class="mt-2 grid gap-1 text-sm text-stone-600">
    <div class="flex gap-2">
      <dt class="font-medium text-stone-500">Year</dt>
      <dd>{grantee.year}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-medium text-stone-500">Field</dt>
      <dd>{grantee.fieldOfStudy}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-medium text-stone-500">Country</dt>
      <dd>{grantee.country}</dd>
    </div>
    <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
      <dt class="shrink-0 font-medium text-stone-500">Applied through</dt>
      <dd>{grantee.appliedThrough}</dd>
    </div>
  </dl>
  {
    grantee.proposalSummary && (
      <p class="mt-3 border-t border-stone-100 pt-3 text-sm italic text-stone-700">
        {grantee.proposalSummary}
      </p>
    )
  }
  {
    grantee.suggestedPathways && grantee.suggestedPathways.length > 0 && (
      <div class="mt-3 border-t border-stone-100 pt-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">Suggested RI pathways</p>
        <ul class="mt-2 space-y-2">
          {grantee.suggestedPathways.map((pathway) => (
            <li class="rounded-lg bg-stone-50 px-2.5 py-2">
              <a class="text-sm font-semibold text-ri-navy underline" href={pathway.actionUrl} target="_blank" rel="noopener">
                {pathway.name}
              </a>
              <p class="mt-0.5 text-xs text-stone-600">
                {pathway.confidence} confidence · {pathway.reasons[0]}
              </p>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>
