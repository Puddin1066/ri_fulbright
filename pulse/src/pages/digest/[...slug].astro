---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('digest', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function prettyFeaturedLabel(href: string): string {
  const known: Record<string, string> = {
    '/atlas?tag=Applicant%20Mentorship': 'Applicant Mentorship Atlas',
    '/atlas?tag=Rhode%20Island%20Innovation': 'Rhode Island Innovation Nodes',
    '/atlas?tag=Community%20Partners': 'Community Partner Nodes',
    '/atlas?tag=Universities': 'University Opportunity Nodes',
    '/atlas?tag=Public%20Events': 'Public Events Nodes',
    '/grantees?field=Public%20Health': 'Public Health Grantees',
    '/grantees?country=Spain': 'Spain Grantee Signal',
  };
  if (known[href]) return known[href];

  // Fallback: make route/query human readable.
  const [path, query] = href.split('?');
  if (!query) return path.replace('/', '').replace(/-/g, ' ') || href;

  const params = new URLSearchParams(query);
  const tag = params.get('tag');
  const field = params.get('field');
  const country = params.get('country');
  if (tag) return `${tag} Atlas`;
  if (field) return `${field} Grantees`;
  if (country) return `${country} Grantee Signal`;
  return href;
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a href="/digest" class="text-sm font-semibold text-ri-navy underline">← All digest issues</a>
    <header class="mt-4 border-b border-stone-200 pb-8">
      <time class="text-sm text-stone-500" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
      </time>
      <h1 class="mt-2 font-display text-3xl font-bold text-ri-navy">{post.data.title}</h1>
      <p class="mt-3 text-lg text-stone-600">{post.data.description}</p>
      {post.data.themes.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.themes.map((theme) => (
            <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-700">{theme}</span>
          ))}
        </div>
      )}
    </header>
    {post.data.shareText && (
      <aside class="mt-6 rounded-xl border border-ri-gold/40 bg-ri-gold/10 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-ri-navy/70">Share-ready message</p>
        <p class="mt-2 text-sm text-stone-700">{post.data.shareText}</p>
      </aside>
    )}
    {post.data.featuredLinks.length > 0 && (
      <aside class="mt-4 rounded-xl border border-stone-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">Featured links</p>
        <ul class="mt-3 space-y-2 text-sm">
          {post.data.featuredLinks.map((href) => (
            <li>
              <a
                class="block rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 font-semibold text-ri-navy hover:border-ri-gold/50 hover:bg-ri-gold/10"
                href={href}
              >
                {prettyFeaturedLabel(href)}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
    <div class="digest-content mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
