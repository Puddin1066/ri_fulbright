---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('digest', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts[0];
---

<BaseLayout title="Digest" description="RI Fulbright Pulse briefing archive with actionable networking and collaboration pathways.">
  <Hero title="Digest" subtitle="Action-oriented briefings for mentorship, career growth, and Rhode Island Fulbright collaboration." />

  <section class="mx-auto max-w-6xl px-4 py-10">
    {
      latest && (
        <div class="mb-10 rounded-2xl border border-ri-gold/40 bg-ri-gold/10 p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-ri-navy/70">Latest issue</p>
          <h2 class="mt-1 font-display text-2xl font-bold text-ri-navy">{latest.data.title}</h2>
          <p class="mt-2 text-stone-700">{latest.data.description}</p>
          {latest.data.themes.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {latest.data.themes.map((theme) => (
                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-ri-navy ring-1 ring-ri-gold/50">
                  {theme}
                </span>
              ))}
            </div>
          )}
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={`/digest/${latest.id}`} class="rounded-lg bg-ri-navy px-4 py-2 text-sm font-semibold text-white hover:bg-ri-navy/90">
              Read latest issue
            </a>
            <a href="/atlas" class="rounded-lg border border-ri-navy px-4 py-2 text-sm font-semibold text-ri-navy hover:bg-white/60">
              Explore Atlas
            </a>
          </div>
        </div>
      )
    }

    <div class="mb-8 rounded-xl border border-stone-200 bg-white p-5">
      <h3 class="font-semibold text-ri-navy">Use this digest for pragmatic outcomes</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-stone-700">
        <li>Applicant outreach and advising handoffs with clear next actions</li>
        <li>Alumni re-engagement through mentoring, speaking, and introductions</li>
        <li>Partner conversations around concrete Rhode Island collaboration nodes</li>
      </ul>
      <p class="mt-3 text-xs text-stone-500">
        Pulse uses AI-assisted drafting with human editorial review before publication.
      </p>
    </div>

    <ul class="divide-y divide-stone-200">
      {
        posts.map((post) => (
          <li class="py-6">
            <a href={`/digest/${post.id}`} class="group block">
              <time class="text-sm text-stone-500" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
              </time>
              <h2 class="mt-1 font-display text-xl font-bold text-ri-navy group-hover:text-ri-gold">{post.data.title}</h2>
              <p class="mt-2 text-stone-600">{post.data.description}</p>
              {post.data.themes.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {post.data.themes.map((theme) => (
                    <span class="rounded-full bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700">{theme}</span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    {posts.length === 0 && <p class="text-stone-600">No digest issues published yet.</p>}
  </section>
</BaseLayout>
