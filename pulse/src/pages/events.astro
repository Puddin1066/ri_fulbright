---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { allEvents, leadership, siteConfig, sortEventsUpcoming } from '../lib/data';

const sorted = sortEventsUpcoming(allEvents);
const today = new Date().toISOString().slice(0, 10);
const termUpdated = new Date(leadership.lastUpdated).toLocaleDateString('en-US', { dateStyle: 'long' });
---

<BaseLayout title="Events" description="Upcoming Fulbright-related events in Rhode Island and chapter leadership for the current term.">
  <Hero
    title="Events & chapter leadership"
    subtitle="Verified upcoming programs from our feed, plus the elected RI chapter board for the current term."
  />

  <section id="leadership" class="border-b border-stone-200 bg-white py-10">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-2xl font-bold text-ri-navy">Chapter leadership</h2>
          <p class="mt-2 max-w-2xl text-stone-700">
            Elected and returning board members for the {leadership.term} term. Membership, dues, and official chapter
            business remain on the{' '}
            <a class="font-semibold text-ri-navy underline" href={siteConfig.officialSiteUrl}>chapter website</a>.
          </p>
        </div>
        <p class="text-sm text-stone-500">Updated {termUpdated}</p>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          leadership.roles.map((role) => (
            <article class="rounded-xl border border-stone-200 bg-stone-50 p-6">
              <h3 class="font-display text-lg font-bold text-ri-navy">{role.title}</h3>
              <ul class="mt-4 space-y-2">
                {role.members.map((member) => (
                  <li class="text-stone-800">{member.name}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      {
        leadership.note && (
          <p class="mt-6 text-sm text-stone-600">{leadership.note}</p>
        )
      }

      <p class="mt-4 text-sm text-stone-600">
        Official results:{' '}
        <a class="font-semibold text-ri-navy underline" href={leadership.sourceUrl} target="_blank" rel="noopener noreferrer">
          Fulbright Association election results
        </a>
        {leadership.contactEmail && (
          <>
            {' '}· Questions:{' '}
            <a class="font-semibold text-ri-navy underline" href={`mailto:${leadership.contactEmail}`}>
              {leadership.contactEmail}
            </a>
          </>
        )}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="font-display text-2xl font-bold text-ri-navy">Upcoming & recent events</h2>
    <p class="mt-2 text-stone-600">Always confirm dates on the host site before you plan to attend.</p>

    <ul class="mt-6 space-y-6">
      {
        sorted.map((ev) => {
          const isPast = ev.startDate < today;
          return (
            <li class:list={['rounded-xl border p-6', isPast ? 'border-stone-200 bg-stone-50 opacity-75' : 'border-stone-200 bg-white shadow-sm']}>
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-semibold text-ri-gold">{ev.startDate}</span>
                {isPast && <span class="rounded bg-stone-200 px-2 py-0.5 text-xs font-medium text-stone-600">Past</span>}
                {ev.tags.map((t) => (
                  <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">{t}</span>
                ))}
              </div>
              <h3 class="mt-2 font-display text-xl font-bold text-ri-navy">{ev.title}</h3>
              <p class="mt-1 text-sm text-stone-600">{ev.location}</p>
              <p class="mt-3 text-stone-700">{ev.description}</p>
              <a href={ev.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block font-semibold text-ri-navy underline">
                Official event page →
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="mt-8 text-sm text-stone-600">
      More events may appear on the{' '}
      <a class="font-semibold underline" href="https://rhodeisland.fulbrightchapters.org/calendar/">RI chapter calendar</a>
      {' '}and <a class="font-semibold underline" href="https://fulbright.org/events/">Fulbright Association events</a>.
    </p>
  </section>
</BaseLayout>
