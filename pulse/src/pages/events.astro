---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { allEvents, sortEventsUpcoming } from '../lib/data';

const sorted = sortEventsUpcoming(allEvents);
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Events" description="Upcoming Fulbright-related events in Rhode Island and New England.">
  <Hero title="Events" subtitle="Verified upcoming programs from our feed. Always confirm dates on the host site." />

  <section class="mx-auto max-w-6xl px-4 py-10">
    <ul class="space-y-6">
      {
        sorted.map((ev) => {
          const isPast = ev.startDate < today;
          return (
            <li class:list={['rounded-xl border p-6', isPast ? 'border-stone-200 bg-stone-50 opacity-75' : 'border-stone-200 bg-white shadow-sm']}>
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-semibold text-ri-gold">{ev.startDate}</span>
                {isPast && <span class="rounded bg-stone-200 px-2 py-0.5 text-xs font-medium text-stone-600">Past</span>}
                {ev.tags.map((t) => (
                  <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">{t}</span>
                ))}
              </div>
              <h2 class="mt-2 font-display text-xl font-bold text-ri-navy">{ev.title}</h2>
              <p class="mt-1 text-sm text-stone-600">{ev.location}</p>
              <p class="mt-3 text-stone-700">{ev.description}</p>
              <a href={ev.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block font-semibold text-ri-navy underline">
                Official event page →
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="mt-8 text-sm text-stone-600">
      More events may appear on the{' '}
      <a class="font-semibold underline" href="https://rhodeisland.fulbrightchapters.org/calendar/">RI chapter calendar</a>
      {' '}and <a class="font-semibold underline" href="https://fulbright.org/events/">Fulbright Association events</a>.
    </p>
  </section>
</BaseLayout>
