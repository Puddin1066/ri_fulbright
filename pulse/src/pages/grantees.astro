---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GranteeCard from '../components/GranteeCard.astro';
import { loadGrantees, loadStats } from '../lib/stats';

const all = loadGrantees();
const stats = loadStats();

const q = (Astro.url.searchParams.get('q') ?? '').toLowerCase();
const year = Astro.url.searchParams.get('year');
const country = Astro.url.searchParams.get('country') ?? '';
const field = Astro.url.searchParams.get('field') ?? '';

const countries = [...new Set(all.map((g) => g.country))].sort();
const fields = [...new Set(all.map((g) => g.fieldOfStudy))].sort();
const years = [...new Set(all.map((g) => g.year))].sort((a, b) => b - a);

const filtered = all.filter((g) => {
  if (year && g.year !== parseInt(year, 10)) return false;
  if (country && g.country !== country) return false;
  if (field && g.fieldOfStudy !== field) return false;
  if (!q) return true;
  const hay = [g.name, g.fieldOfStudy, g.country, g.appliedThrough, g.proposalSummary].join(' ').toLowerCase();
  return hay.includes(q);
});

const limited = filtered.slice(0, 60);
const truncated = filtered.length > 60;
---

<BaseLayout title="Grantee Explorer" description="Browse Rhode Island Fulbright grantees by year, field, and country.">
  <Hero
    title="Grantee Explorer"
    subtitle="Public grant metadata for Rhode Island–affiliated Fulbrighters. No contact information is published."
  />

  <section class="mx-auto max-w-6xl px-4 py-10">
  {
    stats && (
      <p class="mb-6 text-sm text-stone-600">
        Showing {filtered.length} of {stats.totalGrantees} grantees ({stats.yearMin}–{stats.yearMax}).
      </p>
    )
  }

    <form method="get" class="grid gap-4 rounded-xl bg-white p-6 shadow-sm ring-1 ring-stone-200 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <label class="text-xs font-semibold text-stone-500" for="q">Search</label>
        <input id="q" name="q" value={Astro.url.searchParams.get('q') ?? ''} class="mt-1 w-full rounded border border-stone-300 px-2 py-1.5 text-sm" />
      </div>
      <div>
        <label class="text-xs font-semibold text-stone-500" for="year">Year</label>
        <select id="year" name="year" class="mt-1 w-full rounded border border-stone-300 px-2 py-1.5 text-sm">
          <option value="">All</option>
          {years.map((y) => (
            <option value={y} selected={year === String(y)}>{y}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="text-xs font-semibold text-stone-500" for="country">Country</label>
        <select id="country" name="country" class="mt-1 w-full rounded border border-stone-300 px-2 py-1.5 text-sm">
          <option value="">All</option>
          {countries.map((c) => (
            <option value={c} selected={country === c}>{c}</option>
          ))}
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class="text-xs font-semibold text-stone-500" for="field">Field</label>
        <select id="field" name="field" class="mt-1 w-full rounded border border-stone-300 px-2 py-1.5 text-sm">
          <option value="">All</option>
          {fields.map((f) => (
            <option value={f} selected={field === f}>{f}</option>
          ))}
        </select>
      </div>
      <div class="flex items-end lg:col-span-5">
        <button type="submit" class="rounded-lg bg-ri-navy px-4 py-2 text-sm font-semibold text-white">Filter</button>
        <a href="/grantees" class="ml-3 text-sm text-stone-600 underline">Reset</a>
      </div>
    </form>

    {truncated && (
      <p class="mt-4 text-sm text-amber-800">Showing first 60 results. Narrow filters to see more.</p>
    )}

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {limited.map((g) => (
        <GranteeCard grantee={g} />
      ))}
    </div>

    {filtered.length === 0 && (
      <p class="mt-8 text-center text-stone-600">No grantees match these filters.</p>
    )}
  </section>
</BaseLayout>
